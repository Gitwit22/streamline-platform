# Streamline Client - local development env vars
# Copy to .env (this repo ignores .env) and fill in values.

# Backend API base URL (required in production)
VITE_API_BASE=http://localhost:5137

# LiveKit WebSocket URL
VITE_LIVEKIT_URL=wss://<your-project>.livekit.cloud

# Stripe publishable key (required when billing is enabled)
# VITE_STRIPE_PUBLISHABLE_KEY=

# Firebase web config (required when using Firebase auth)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Firebase password-reset continue URL (optional)
# VITE_FIREBASE_CONTINUE_URL=
