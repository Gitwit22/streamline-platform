# Streamline Client - local development env vars
# Copy to .env.local (Vite auto-loads this; git-ignored).

# ── Program / Lane Selection ──────────────────────────────────────
# Controls which StreamLine lane this frontend build targets.
# Values: "edu" (default) | "corporate"
# If unset, defaults to "edu" and all lanes remain accessible (local dev).
# VITE_STREAMLINE_PROGRAM=edu

# Optional: override the displayed app name and tagline.
# If unset, the value from the selected program config is used.
# VITE_APP_NAME=StreamLine EDU
# VITE_APP_TAGLINE=The learning experience platform for modern schools

# ── API Configuration ─────────────────────────────────────────────
# Backend API base URL. Defaults to the production Render URL if unset.
# Always set this explicitly — leaving it unset risks hitting production data.
# VITE_API_BASE_URL=https://api.streamline.nxtlvlts.com
VITE_API_BASE=http://localhost:5137

# Optional: override the Support Hub URL for this lane.
# VITE_SUPPORT_HUB_URL=

# ── Multi-Tenant Isolation ────────────────────────────────────────
# VITE_APP_ENV controls the environment badge shown in the UI.
# Values: "local" (default), "test", "prod"
VITE_APP_ENV=local

# ── Firebase (required for auth) ──────────────────────────────────
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_CONTINUE_URL=

# ── Stripe (required for billing) ────────────────────────────────
# VITE_STRIPE_PUBLISHABLE_KEY=

# ── LiveKit ───────────────────────────────────────────────────────
# VITE_LIVEKIT_URL=
