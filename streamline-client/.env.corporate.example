# StreamLine Corporate — frontend deployment env vars
# Use these values when deploying the Corporate frontend.
# Deploy as a separate Vercel / Netlify / Render static site project.
# Both EDU and Corporate frontend builds can point to the same backend API.

# ── Program / Lane ────────────────────────────────────────────────
VITE_STREAMLINE_PROGRAM=corporate

# ── Branding (optional — defaults come from program config) ───────
# VITE_APP_NAME=StreamLine Corporate
# VITE_APP_TAGLINE=The professional communications platform for modern organizations

# ── API ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://api.streamline.nxtlvlts.com

# ── Environment ───────────────────────────────────────────────────
VITE_APP_ENV=prod

# ── Firebase ──────────────────────────────────────────────────────
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# ── Stripe ────────────────────────────────────────────────────────
# VITE_STRIPE_PUBLISHABLE_KEY=

# ── LiveKit ───────────────────────────────────────────────────────
# VITE_LIVEKIT_URL=
