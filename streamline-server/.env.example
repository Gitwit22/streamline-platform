# Streamline Server - local development env vars
# Copy to .env (this repo ignores .env) and fill in values.

# Required for Firebase Admin SDK:
# Option A (recommended): point to a local service-account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=C:\\path\\to\\firebase-service-account.json

# Option B: inline JSON (harder on Windows quoting)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Option C: base64-encoded JSON (single line)
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwuLi59

# Other common settings
CLIENT_URL=http://localhost:5173
PORT=3001
JWT_SECRET=dev-secret

# Firebase Web API Key (from Firebase Console → Project Settings → General).
# Required for legacy accounts that stored passwords only in Firebase Auth.
# Once all legacy users have logged in and migrated, this can be removed.
# FIREBASE_API_KEY=...

# LiveKit (if using)
# LIVEKIT_URL=wss://...
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...

# HLS public playback base (Cloudflare Worker or CDN)
# Local dev (wrangler dev): http://localhost:8787/hls
# Production (Cloudflare Worker on your domain): https://cdn.your-domain.com/hls
HLS_PUBLIC_BASE_URL=http://localhost:8787/hls

# Stripe
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BASIC=

# Cloudflare R2 (recordings storage)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_USER_ACCESS_KEY_ID=
# R2_USER_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=streamline-recordings
# R2_BUCKET=streamline-recordings
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCOUNT_ID=
# R2_ACCOUNT_ACCESS_KEY_ID=
# R2_ACCOUNT_SECRET_ACCESS_KEY=

# ── Email / Corporate Notifications ───────────────────────────────────────────
# EMAIL_PROVIDER controls which email backend is used.
# Use "stub" (the default) until a real provider (e.g. Resend) is configured.
# The stub logs would-send emails to the console and writes an EmailLog record.
EMAIL_PROVIDER=stub
EMAIL_SEND_ENABLED=false
EMAIL_FROM_NAME=StreamLine
EMAIL_FROM_ADDRESS=no-reply@nxtlvlts.com
# Optional explicit sender override used by notification-core.
# EMAIL_FROM=StreamLine <no-reply@nxtlvlts.com>
EMAIL_REPLY_TO=
# RESEND_API_KEY=          (only needed when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# Frontend route base for invite acceptance links in email.
# Example: http://localhost:5173/corporate/invite
CORPORATE_INVITE_BASE_URL=http://localhost:5173/corporate/invite

# Horizon Bot Integration
# HORIZON_WEBHOOK_URL   – URL where StreamLine POSTs outbound events (chat, voice) to the bot.
#                         Example: https://horizon.yourdomain.com/api/streamline/event
# HORIZON_BEARER_TOKEN  – Shared secret for Authorization: Bearer header (both directions).
# HORIZON_WEBHOOK_SECRET – Shared secret for HMAC-SHA256 signature (X-Horizon-Signature header).
# HORIZON_WEBHOOK_URL=https://horizon.yourdomain.com/api/streamline/event
# HORIZON_BEARER_TOKEN=...
# HORIZON_WEBHOOK_SECRET=...

# ---- StreamLine Platform Event Hooks ----
# Enable the unified event hook system.  When "true", standardized platform
# events (chat, voice, support, monitoring, room, alert) are dispatched to
# the configured webhook destinations below.
# STREAMLINE_HOOKS_ENABLED=true

# Per-category webhook destination URLs.
# STREAMLINE_CHAT_EVENT_URL=https://your-webhook-server/api/streamline/chat-event
# STREAMLINE_VOICE_EVENT_URL=https://your-webhook-server/api/streamline/voice-event
# STREAMLINE_SUPPORT_EVENT_URL=https://your-webhook-server/api/streamline/support-event
# STREAMLINE_MONITORING_EVENT_URL=https://your-webhook-server/api/streamline/monitoring-event
# STREAMLINE_ALERT_EVENT_URL=https://your-webhook-server/api/streamline/alert-event
# STREAMLINE_ROOM_EVENT_URL=https://your-webhook-server/api/streamline/room-event

# Shared HMAC secret for signing outbound event payloads (X-Streamline-Signature).
# STREAMLINE_WEBHOOK_SECRET=replace-me

# Delivery timeout per attempt (milliseconds).
# STREAMLINE_WEBHOOK_TIMEOUT_MS=5000

# Number of delivery attempts (including the initial try).
# STREAMLINE_WEBHOOK_RETRY_COUNT=3
